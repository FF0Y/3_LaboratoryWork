{
  "name": "my-first-extension",
  "displayName": "Шаблоны кода — библиотека алгоритмов",
  "description": "Сохранение алгоритмов по категориям, поиск, параметры, редактирование и импорт/экспорт JSON.",
  "version": "0.1.0",
  "engines": {
    "vscode": "^1.145.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onFileSystem:algorithm-template"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "my-first-extension.saveTemplate",
        "title": "Сохранить выделение",
        "category": "Шаблоны кода"
      },
      {
        "command": "my-first-extension.insertTemplate",
        "title": "Вставить шаблон",
        "category": "Шаблоны кода"
      },
      {
        "command": "my-first-extension.searchTemplates",
        "title": "Найти шаблон",
        "category": "Шаблоны кода"
      },
      {
        "command": "my-first-extension.browseCategories",
        "title": "Выбрать категорию и вставить",
        "category": "Шаблоны кода"
      },
      {
        "command": "my-first-extension.editTemplate",
        "title": "Редактировать шаблон",
        "category": "Шаблоны кода"
      },
      {
        "command": "my-first-extension.renameTemplate",
        "title": "Переименовать шаблон",
        "category": "Шаблоны кода"
      },
      {
        "command": "my-first-extension.deleteTemplate",
        "title": "Удалить шаблон",
        "category": "Шаблоны кода"
      },
      {
        "command": "my-first-extension.exportTemplates",
        "title": "Экспортировать библиотеку",
        "category": "Шаблоны кода"
      },
      {
        "command": "my-first-extension.importTemplates",
        "title": "Импортировать библиотеку",
        "category": "Шаблоны кода"
      },
      {
        "command": "my-first-extension.helloWorld",
        "title": "Hello World"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "my-first-extension.saveTemplate",
          "when": "editorHasSelection",
          "group": "1_modification@10"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test",
    "test:unit": "node tests/run-unit.cjs"
  },
  "devDependencies": {
    "@types/vscode": "^1.145.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "typescript-eslint": "^8.61.1",
    "eslint": "^10.5.0",
    "esbuild": "^0.28.1",
    "npm-run-all": "^4.1.5",
    "typescript": "^6.0.3",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  },
  "publisher": "FF0Y",
  "repository": {
    "type": "git",
    "url": "https://github.com/FF0Y/3_LaboratoryWork.git"
  }
}
